<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenCVGui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="OpenCVGui.Views.HistogramWindow"
        x:DataType="vm:HistogramViewModel"
        Title="Histogram"
        Width="800" Height="600"
        MinWidth="600" MinHeight="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Image Histogram" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0"
                    BorderBrush="#3E3E3E"
                    BorderThickness="1"
                    Background="#1E1E1E"
                    Padding="10">
                <Viewbox Stretch="Uniform">
                    <Grid Width="800" Height="500">
                        <Image x:Name="HistogramImage"
                               Width="800"
                               Height="500"
                               Stretch="None"/>
                        <Canvas x:Name="HistogramOverlay"
                                Width="800"
                                Height="500"
                                Background="Transparent"
                                IsHitTestVisible="True"/>
                    </Grid>
                </Viewbox>
            </Border>
            
            <Border Grid.Column="1"
                    BorderBrush="#3E3E3E"
                    BorderThickness="1,0,0,0"
                    Background="#1E1E1E"
                    Padding="10">
                <ScrollViewer>
                    <TextBlock x:Name="HoverValueText"
                               Text="Hover over the chart to see values"
                               TextWrapping="Wrap"
                               Foreground="#E0E0E0"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    Spacing="10"
                    Margin="0,10,0,0">
            <TextBlock Text="Channels:" 
                       VerticalAlignment="Center"/>
            <CheckBox IsChecked="{Binding UseLogScale}"
                      Content="Log Scale Y-Axis"
                      VerticalAlignment="Center"
                      Margin="10,0,0,0"/>
            <ItemsControl ItemsSource="{Binding Channels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsVisible}"
                                  Content="{Binding Name}"
                                  Background="{Binding Color}"
                                  VerticalAlignment="Center">

                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Window>

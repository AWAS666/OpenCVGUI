<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:OpenCVGui.ViewModels"
		xmlns:controls="using:OpenCVGui.Views.Controls"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:lucideAvalonia="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
		mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900"
		x:Class="OpenCVGui.Views.CustomControlWindow"
		x:DataType="vm:LayerViewModel"
		Title="Custom Control"
		Width="1200" Height="900"
		MinWidth="800" MinHeight="700">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Header -->
		<Border Grid.Row="0" 
				Background="#2D2D30" 
				BorderBrush="#3E3E3E" 
				BorderThickness="0,0,0,1"
				Padding="10">
			<TextBlock Text="{Binding DisplayName}" 
					   FontSize="14" 
					   FontWeight="SemiBold"
					   VerticalAlignment="Center"/>
		</Border>

		<!-- Custom Control Content -->
		<ContentControl x:Name="CustomControlContent" 
						Grid.Row="1" 
						Content="{Binding}">
			<ContentControl.ContentTemplate>
				<controls:CustomControlTemplateSelector/>
			</ContentControl.ContentTemplate>
		</ContentControl>
	</Grid>
</Window>



<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenCVGui.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lucideAvalonia="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="400"
             x:Class="OpenCVGui.Views.Controls.LayerListControl"
             x:DataType="vm:MainWindowViewModel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <ListBox Grid.Row="0"
                 ItemsSource="{Binding Layers}"
                 SelectedItem="{Binding SelectedLayer}"
                 SelectionMode="Single"
                 x:Name="LayerListBox"
                 DragDrop.AllowDrop="True"
                 DragDrop.DragOver="LayerListBox_DragOver"
                 DragDrop.Drop="LayerListBox_Drop"
                 Focusable="True">
            <ListBox.KeyBindings>
                <KeyBinding Gesture="Delete" Command="{Binding RemoveLayerCommand}"/>
            </ListBox.KeyBindings>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="3"
                            Margin="0,1"
                            x:Name="LayerItemBorder"
                            Cursor="Hand"
                            Background="Transparent"
                            PointerPressed="LayerItemBorder_PointerPressed"
                            PointerMoved="LayerItemBorder_PointerMoved"
                            PointerReleased="LayerItemBorder_PointerReleased">
                        <Border.Styles>
                            <Style Selector="Border:selected">
                                <Setter Property="Background" Value="#3E3E3E"/>
                            </Style>
                        </Border.Styles>
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <CheckBox Grid.Column="0" 
                                      IsChecked="{Binding IsEnabled}"
                                      Margin="0,0,5,0"
                                      VerticalAlignment="Center"/>
                            
                            <TextBlock Grid.Column="1"
                                       Text="⚠"
                                       FontSize="14"
                                       Foreground="#FF4444"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0"
                                       IsVisible="{Binding HasError}"
                                       ToolTip.Tip="{Binding Layer.LastError}"/>
                            
                            <StackPanel Grid.Column="2">
                                   
                                <TextBox Text="{Binding Name, Mode=TwoWay}" 
                                        HorizontalAlignment="Left"
                                        FontWeight="Bold"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="1,5,5,5"
                                        Margin="0"
                                        MaxWidth="350"
                                        VerticalAlignment="Center"
                                        Watermark="{Binding LayerType}"/>
                                <TextBlock Text="{Binding LayerType}" 
                                           FontSize="10" 
                                           Foreground="Gray"/>
                            </StackPanel>
                            
                            <TextBlock Grid.Column="3" 
                                       Text="{Binding LastRuntime, StringFormat='{}{0:F2}ms'}"
                                       FontSize="10"
                                       Foreground="Gray"
                                       VerticalAlignment="Center"
                                       Margin="5,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <!-- Total Runtime Footer -->
        <Border Grid.Row="1"
                BorderBrush="#3E3E3E"
                BorderThickness="0,1,0,0"
                Padding="5"
                Background="#2E2E2E">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Total Runtime:"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding TotalRuntime, StringFormat='{}{0:F2}ms'}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#4CAF50"
                           VerticalAlignment="Center"
                           Margin="5,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>


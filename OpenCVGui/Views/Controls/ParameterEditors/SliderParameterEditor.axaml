<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:OpenCVGui.ViewModels"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 x:Class="OpenCVGui.Views.Controls.ParameterEditors.SliderParameterEditor"
			 x:DataType="vm:ParameterProperty">
	<StackPanel Orientation="Vertical" Spacing="10">
		<Slider Minimum="{Binding RangeAttribute.Minimum}"
				Maximum="{Binding RangeAttribute.Maximum}"
				Value="{Binding Value, Mode=TwoWay}"
				TickFrequency="{Binding RangeAttribute.Step}"
				IsSnapToTickEnabled="True"/>
		<NumericUpDown Width="120"
					   HorizontalAlignment="Left"
					   Minimum="{Binding RangeAttribute.Minimum}"
					   Maximum="{Binding RangeAttribute.Maximum}"
					   Increment="{Binding RangeAttribute.Step}"
					   Value="{Binding Value, Mode=TwoWay}"/>
	</StackPanel>
</UserControl>


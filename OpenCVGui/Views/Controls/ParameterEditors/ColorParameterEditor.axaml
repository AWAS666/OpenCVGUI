<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:OpenCVGui.ViewModels"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 x:Class="OpenCVGui.Views.Controls.ParameterEditors.ColorParameterEditor"
			 x:DataType="vm:ParameterProperty">
	<StackPanel>
		<ColorPicker Color="{Binding ColorValue, Mode=TwoWay}"
					 Margin="0,0,0,5"/>
		<TextBox Text="{Binding Value, Mode=TwoWay}"
				 Watermark="Hex color (e.g., #FF0000)"/>
	</StackPanel>
</UserControl>


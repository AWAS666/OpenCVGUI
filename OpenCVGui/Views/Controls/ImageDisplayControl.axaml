<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenCVGui.ViewModels"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:lucideAvalonia="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="OpenCVGui.Views.Controls.ImageDisplayControl"
             x:DataType="vm:MainWindowViewModel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Image Display -->
        <Border Grid.Row="0"
                Background="#1E1E1E" 
                BorderBrush="#3E3E3E" 
                BorderThickness="1"
                x:Name="ImageContainer">
            <Grid>
                <ScrollViewer x:Name="ImageScrollViewer"
                              HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Auto">
                    <Border x:Name="ImageBorder"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Image x:Name="DisplayImageControl"
                               Source="{Binding DisplayImage}" 
                               Stretch="None"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy Image"
                                              Command="{Binding CopyImageToClipboardCommand}"
                                              IsEnabled="{Binding CanCopyImageToClipboard}">
                                        <MenuItem.Icon>
                                            <lucideAvalonia:Lucide Icon="Copy" 
                                                                   StrokeBrush="White" 
                                                                   StrokeThickness="1.5" 
                                                                   Width="16" 
                                                                   Height="16"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Image.ContextMenu>
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="{Binding ZoomLevel}" 
                                                   ScaleY="{Binding ZoomLevel}"/>
                                    <TranslateTransform X="{Binding PanX}" 
                                                       Y="{Binding PanY}"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Border>
                </ScrollViewer>
                
                <!-- Crop Selection Rectangle Overlay -->
                <Canvas x:Name="CropOverlayCanvas"
                        IsVisible="{Binding IsCropMode}"
                        IsHitTestVisible="False">
                    <Rectangle x:Name="CropSelectionRectangle"
                               Stroke="#00FF00"
                               StrokeThickness="2"
                               StrokeDashArray="4,4"
                               Fill="#4000FF00"
                               IsVisible="False"/>
                </Canvas>
            </Grid>
        </Border>
        
        <!-- Bottom Toolbar -->
        <Border Grid.Row="1"
                Background="#2E2E2E"
                BorderBrush="#3E3E3E"
                BorderThickness="1,0,1,1"
                Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Status Area (Left) -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal" 
                            Spacing="8"
                            VerticalAlignment="Center">
                    <!-- Loading Indicator -->
                    <StackPanel Orientation="Horizontal" 
                                Spacing="6"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsRendering}">
                        <ProgressBar IsIndeterminate="True"
                                     Width="14"
                                     Height="14"
                                     VerticalAlignment="Center"/>
                        <TextBlock Text="Processing..."
                                   FontSize="10"
                                   Foreground="#888888"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Error Indicator -->
                    <StackPanel Orientation="Horizontal" 
                                Spacing="6"
                                VerticalAlignment="Center"
                                IsVisible="{Binding HasErrors}">
                        <TextBlock Text="⚠"
                                   FontSize="12"
                                   Foreground="#FF4444"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorLog.Count, StringFormat='{}{0} error(s)'}"
                                   FontSize="10"
                                   Foreground="#FF8888"
                                   VerticalAlignment="Center"
                                   Cursor="Hand">
                            <ToolTip.Tip>
                                <ItemsControl ItemsSource="{Binding ErrorLog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ToolTip.Tip>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                
                <!-- Toolbar Buttons (Right) -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal" 
                            Spacing="5">
                <!-- Crop Apply Button -->
                <Button Command="{Binding ApplyCropCommand}"
                        ToolTip.Tip="Apply Crop"
                        Padding="8"
                        IsVisible="{Binding IsCropMode}">
                    <lucideAvalonia:Lucide Icon="Check" 
                                           StrokeBrush="#00FF00" 
                                           StrokeThickness="2" 
                                           Width="20" 
                                           Height="20"/>
                </Button>
                
                <!-- Crop Cancel Button -->
                <Button Command="{Binding CancelCropCommand}"
                        ToolTip.Tip="Cancel Crop"
                        Padding="8"
                        IsVisible="{Binding IsCropMode}">
                    <lucideAvalonia:Lucide Icon="X" 
                                           StrokeBrush="#FF0000" 
                                           StrokeThickness="2" 
                                           Width="20" 
                                           Height="20"/>
                </Button>
                
                <!-- Step Backward Button -->
                <Button Command="{Binding StepFrameBackwardCommand}"
                        ToolTip.Tip="Step Backward One Frame"
                        Padding="8"
                        HotKey="Left"
                        IsVisible="{Binding CanStepFrames}">
                    <lucideAvalonia:Lucide Icon="ArrowLeftToLine" 
                                           StrokeBrush="White" 
                                           StrokeThickness="1.5" 
                                           Width="20" 
                                           Height="20"/>
                </Button>
                
                <!-- Step Forward Button -->
                <Button Command="{Binding StepFrameForwardCommand}"
                        ToolTip.Tip="Step Forward One Frame"
                        Padding="8"
                        HotKey="Right"
                        IsVisible="{Binding CanStepFrames}">
                    <lucideAvalonia:Lucide Icon="ArrowRightToLine" 
                                           StrokeBrush="White" 
                                           StrokeThickness="1.5" 
                                           Width="20" 
                                           Height="20"/>
                </Button>
                
                <!-- Pause/Play Button -->
                <Button Command="{Binding ToggleStreamingPauseCommand}"
                        ToolTip.Tip="{Binding PauseButtonTooltip}"
                        Padding="8"
                        HotKey="Space"
                        IsVisible="{Binding IsStreamingActive}">
                    <lucideAvalonia:Lucide Icon="Pause" 
                                           StrokeBrush="White" 
                                           StrokeThickness="1.5" 
                                           Width="20" 
                                           Height="20"/>
                </Button>
                
                <!-- Export Button -->
                <Button Command="{Binding ExportImageCommand}"
                        ToolTip.Tip="Export Image"
                        Padding="8">
                    <Button.IsEnabled>
                        <Binding Path="DisplayImage" Converter="{x:Static converters:ObjectConverters.IsNotNull}"/>
                    </Button.IsEnabled>
                    <lucideAvalonia:Lucide Icon="Download" 
                                           StrokeBrush="White" 
                                           StrokeThickness="1.5" 
                                           Width="20" 
                                           Height="20"/>
                </Button>
                
                <!-- Zoom Out Button -->
                <Button Command="{Binding ZoomOutCommand}"
                        ToolTip.Tip="Zoom Out"
                        Padding="8">
                    <Button.IsEnabled>
                        <Binding Path="DisplayImage" Converter="{x:Static converters:ObjectConverters.IsNotNull}"/>
                    </Button.IsEnabled>
                    <lucideAvalonia:Lucide Icon="ZoomOut" 
                                           StrokeBrush="White" 
                                           StrokeThickness="1.5" 
                                           Width="20" 
                                           Height="20"/>
                </Button>
                
                <!-- Fit to View Button -->
                <Button Command="{Binding FitToViewCommand}"
                        ToolTip.Tip="Fit to View"
                        Padding="8">
                    <Button.IsEnabled>
                        <Binding Path="DisplayImage" Converter="{x:Static converters:ObjectConverters.IsNotNull}"/>
                    </Button.IsEnabled>
                    <lucideAvalonia:Lucide Icon="Maximize2" 
                                           StrokeBrush="White" 
                                           StrokeThickness="1.5" 
                                           Width="20" 
                                           Height="20"/>
                </Button>
                
                <!-- Zoom In Button -->
                <Button Command="{Binding ZoomInCommand}"
                        ToolTip.Tip="Zoom In"
                        Padding="8">
                    <Button.IsEnabled>
                        <Binding Path="DisplayImage" Converter="{x:Static converters:ObjectConverters.IsNotNull}"/>
                    </Button.IsEnabled>
                    <lucideAvalonia:Lucide Icon="ZoomIn" 
                                           StrokeBrush="White" 
                                           StrokeThickness="1.5" 
                                           Width="20" 
                                           Height="20"/>
                </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>


<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenCVGui.ViewModels"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:lucideAvalonia="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="OpenCVGui.Views.Controls.ImageDisplayControl"
             x:DataType="vm:MainWindowViewModel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Image Display -->
        <Border Grid.Row="0"
                Background="#1E1E1E" 
                BorderBrush="#3E3E3E" 
                BorderThickness="1"
                x:Name="ImageContainer">
            <ScrollViewer x:Name="ImageScrollViewer"
                          HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Auto">
                <Border x:Name="ImageBorder"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Image x:Name="DisplayImageControl"
                           Source="{Binding DisplayImage}" 
                           Stretch="None"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding ZoomLevel}" 
                                               ScaleY="{Binding ZoomLevel}"/>
                                <TranslateTransform X="{Binding PanX}" 
                                                   Y="{Binding PanY}"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Border>
            </ScrollViewer>
        </Border>
        
        <!-- Bottom Toolbar -->
        <Border Grid.Row="1"
                Background="#2E2E2E"
                BorderBrush="#3E3E3E"
                BorderThickness="1,0,1,1"
                Padding="5">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right"
                        Spacing="5">
                <!-- Step Backward Button -->
                <Button Command="{Binding StepFrameBackwardCommand}"
                        ToolTip.Tip="Step Backward One Frame"
                        Padding="8"
                        IsVisible="{Binding CanStepFrames}">
                    <lucideAvalonia:Lucide Icon="ArrowLeftToLine" 
                                           StrokeBrush="White" 
                                           StrokeThickness="1.5" 
                                           Width="20" 
                                           Height="20"/>
                </Button>
                
                <!-- Step Forward Button -->
                <Button Command="{Binding StepFrameForwardCommand}"
                        ToolTip.Tip="Step Forward One Frame"
                        Padding="8"
                        IsVisible="{Binding CanStepFrames}">
                    <lucideAvalonia:Lucide Icon="ArrowRightToLine" 
                                           StrokeBrush="White" 
                                           StrokeThickness="1.5" 
                                           Width="20" 
                                           Height="20"/>
                </Button>
                
                <!-- Pause/Play Button -->
                <Button Command="{Binding ToggleStreamingPauseCommand}"
                        ToolTip.Tip="{Binding PauseButtonTooltip}"
                        Padding="8"
                        IsVisible="{Binding IsStreamingActive}">
                    <lucideAvalonia:Lucide Icon="Pause" 
                                           StrokeBrush="White" 
                                           StrokeThickness="1.5" 
                                           Width="20" 
                                           Height="20"/>
                </Button>
                
                <!-- Export Button -->
                <Button Command="{Binding ExportImageCommand}"
                        ToolTip.Tip="Export Image"
                        Padding="8">
                    <Button.IsEnabled>
                        <Binding Path="DisplayImage" Converter="{x:Static converters:ObjectConverters.IsNotNull}"/>
                    </Button.IsEnabled>
                    <lucideAvalonia:Lucide Icon="Download" 
                                           StrokeBrush="White" 
                                           StrokeThickness="1.5" 
                                           Width="20" 
                                           Height="20"/>
                </Button>
                
                <!-- Zoom Out Button -->
                <Button Command="{Binding ZoomOutCommand}"
                        ToolTip.Tip="Zoom Out"
                        Padding="8">
                    <Button.IsEnabled>
                        <Binding Path="DisplayImage" Converter="{x:Static converters:ObjectConverters.IsNotNull}"/>
                    </Button.IsEnabled>
                    <lucideAvalonia:Lucide Icon="ZoomOut" 
                                           StrokeBrush="White" 
                                           StrokeThickness="1.5" 
                                           Width="20" 
                                           Height="20"/>
                </Button>
                
                <!-- Fit to View Button -->
                <Button Command="{Binding FitToViewCommand}"
                        ToolTip.Tip="Fit to View"
                        Padding="8">
                    <Button.IsEnabled>
                        <Binding Path="DisplayImage" Converter="{x:Static converters:ObjectConverters.IsNotNull}"/>
                    </Button.IsEnabled>
                    <lucideAvalonia:Lucide Icon="Maximize2" 
                                           StrokeBrush="White" 
                                           StrokeThickness="1.5" 
                                           Width="20" 
                                           Height="20"/>
                </Button>
                
                <!-- Zoom In Button -->
                <Button Command="{Binding ZoomInCommand}"
                        ToolTip.Tip="Zoom In"
                        Padding="8">
                    <Button.IsEnabled>
                        <Binding Path="DisplayImage" Converter="{x:Static converters:ObjectConverters.IsNotNull}"/>
                    </Button.IsEnabled>
                    <lucideAvalonia:Lucide Icon="ZoomIn" 
                                           StrokeBrush="White" 
                                           StrokeThickness="1.5" 
                                           Width="20" 
                                           Height="20"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>


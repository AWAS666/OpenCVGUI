<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenCVGui.ViewModels"
        xmlns:controls="using:OpenCVGui.Views.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lucideAvalonia="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="OpenCVGui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="OpenCV Layer Chain Editor"
        Width="1200" Height="800">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="File">
                <MenuItem Header="Save Chain" InputGesture="Ctrl+S"
                          Command="{Binding SaveChainCommand}"
                          HotKey="Ctrl+S"/>
                <MenuItem Header="Save Chain As..." 
                          Command="{Binding SaveAsChainCommand}"/>
                <MenuItem Header="Load Chain" InputGesture="Ctrl+O"
                          Command="{Binding LoadChainCommand}"
                          HotKey="Ctrl+O"/>
            </MenuItem>
            <MenuItem Command="{Binding SetRenderModeCommand}"
                        CommandParameter="UI"
                        IsEnabled="{Binding IsChainRenderMode}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <lucideAvalonia:Lucide Icon="Eye" 
                                               StrokeBrush="{Binding UIRenderModeIconColor}" 
                                               StrokeThickness="2" 
                                               Width="16" 
                                               Height="16"/>
                        <TextBlock Text="UI Render Mode"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Command="{Binding SetRenderModeCommand}"
                        CommandParameter="Chain"
                        IsEnabled="{Binding IsUIRenderMode}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <lucideAvalonia:Lucide Icon="Link" 
                                               StrokeBrush="{Binding ChainRenderModeIconColor}" 
                                               StrokeThickness="2" 
                                               Width="16" 
                                               Height="16"/>
                        <TextBlock Text="Chain Render Mode"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
        </Menu>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Image Display Area (Center) -->
            <controls:ImageDisplayControl Grid.Column="0" Margin="5"/>

            <!-- Layer Panel (Right) -->
            <Grid Grid.Column="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Layer List Header -->
                <TextBlock Grid.Row="0" 
                           Text="Layers" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Margin="0,0,0,5"/>
                
                <!-- Layer Controls -->
                <controls:LayerControlsControl Grid.Row="1" Margin="0,0,0,5"/>

                <!-- Layer List -->
                <controls:LayerListControl Grid.Row="2"/>

                <!-- Parameter Editor -->
                <Border Grid.Row="3"
                        BorderBrush="#3E3E3E"
                        BorderThickness="0,1,0,0"
                        Margin="0,10,0,0"
                        Padding="5">
                    <controls:ParameterEditorControl/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
